    "@supabase/supabase-js": "^2.118.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-node": "^4.22.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
